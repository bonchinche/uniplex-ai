FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements-image-ai.txt /app/requirements.txt

RUN pip install --no-cache-dir -r /app/requirements.txt \
    && mkdir -p /app/image_ai/providers

COPY --chown=0:0 --chmod=0444 scripts/image_ai/__init__.py /app/image_ai/__init__.py
COPY --chown=0:0 --chmod=0444 scripts/image_ai/config_loader.py /app/image_ai/config_loader.py
COPY --chown=0:0 --chmod=0444 scripts/image_ai/contracts.py /app/image_ai/contracts.py
COPY --chown=0:0 --chmod=0444 scripts/image_ai/provider_base.py /app/image_ai/provider_base.py
COPY --chown=0:0 --chmod=0444 scripts/image_ai/provider_registry.py /app/image_ai/provider_registry.py
COPY --chown=0:0 --chmod=0444 scripts/image_ai/queue.py /app/image_ai/queue.py
COPY --chown=0:0 --chmod=0444 scripts/image_ai/worker.py /app/image_ai/worker.py
COPY --chown=0:0 --chmod=0444 scripts/image_ai/writer.py /app/image_ai/writer.py
COPY --chown=0:0 --chmod=0444 scripts/image_ai/providers/__init__.py /app/image_ai/providers/__init__.py
COPY --chown=0:0 --chmod=0444 scripts/image_ai/providers/mock_provider.py /app/image_ai/providers/mock_provider.py

USER 1000:1000

ENTRYPOINT ["python", "-m", "image_ai.worker"]
