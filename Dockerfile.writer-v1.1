FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-writer.txt .
RUN pip install --no-cache-dir -r requirements-writer.txt
COPY --chmod=0444 scripts/document_writer_v1.1.py /app/document_writer.py
USER 10001:10001
ENTRYPOINT ["python", "/app/document_writer.py"]
