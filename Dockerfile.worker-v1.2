FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-importer.txt .
RUN pip install --no-cache-dir -r requirements-importer.txt

COPY --chmod=0444 scripts/queue_worker_v1.2.py /app/queue_worker.py
COPY --chmod=0444 scripts/process_email_v2.py /app/process_email.py
COPY --chmod=0444 scripts/mime_parser_v2.py /app/mime_parser.py

USER 10001:10001

ENTRYPOINT ["python", "/app/queue_worker.py"]
