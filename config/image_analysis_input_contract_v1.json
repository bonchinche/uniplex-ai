{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniplex.local/schemas/image-analysis-input/v1.0",
  "title": "UNIPLEX Image Analysis Input Contract",
  "description": "Provider-independent request metadata. Image bytes are transported separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "task",
    "source",
    "image_payload",
    "instructions",
    "output_contract"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "const": "describe_and_extract"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment_id",
        "sha256",
        "mime_type",
        "size_bytes"
      ],
      "properties": {
        "attachment_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "mime_type": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/tiff",
            "image/bmp"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "filename": {
          "type": "string"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "image_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "part_name"
      ],
      "properties": {
        "transport": {
          "const": "binary_part"
        },
        "part_name": {
          "const": "image"
        }
      }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language_mode",
        "extraction_scope",
        "domain_context"
      ],
      "properties": {
        "language_mode": {
          "type": "string",
          "enum": [
            "auto",
            "same_as_source",
            "ru",
            "en"
          ]
        },
        "extraction_scope": {
          "type": "string",
          "minLength": 1
        },
        "domain_context": {
          "type": "string"
        }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "UNIPLEX Image Analysis Contract"
        },
        "version": {
          "const": "1.0"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      }
    }
  }
}
