FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-importer.txt .
RUN pip install --no-cache-dir -r requirements-importer.txt

COPY --chmod=0444 scripts/sync_inbox_v1.1.py /app/sync_inbox.py

USER 10001:10001

ENTRYPOINT ["python", "/app/sync_inbox.py"]
