FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-document.txt .

RUN pip install --no-cache-dir -r requirements-document.txt

COPY --chmod=0444 scripts/extract_xlsx.py /app/extract_xlsx.py

USER 10001:10001

ENTRYPOINT ["python", "/app/extract_xlsx.py"]
